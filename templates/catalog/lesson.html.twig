{% extends 'base.html.twig' %}{% block body %}<main><h1>{{ lesson.title }}</h1><p>{{ lesson.content }}</p><div aria-label="Vidéo de la leçon">Vidéo pédagogique à venir</div><form method="post" action="{{ path('app_validate_lesson', {id: lesson.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('validate-lesson-' ~ lesson.id) }}"><button>Valider cette leçon</button></form></main>{% endblock %}
