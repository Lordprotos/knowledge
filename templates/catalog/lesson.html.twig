{% extends 'base.html.twig' %}
{% block body %}
<main>
    <h1>{{ lesson.title }}</h1>
    {% if lesson.videoUrl %}
        <video controls class="lesson-video"><source src="{{ lesson.videoUrl }}">Votre navigateur ne peut pas lire cette vidéo.</video>
    {% endif %}
    <p>{{ lesson.content }}</p>
    <form method="post" action="{{ path('app_validate_lesson', {id: lesson.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('validate-lesson-' ~ lesson.id) }}"><button>Valider cette leçon</button></form>
</main>
{% endblock %}
