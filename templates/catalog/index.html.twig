{% extends 'base.html.twig' %}
{% block body %}
    <main>
        <section class="hero">
            <p class="eyebrow">
                Apprendre à son rythme
            </p>
            <h1>Des formations simples, pour des passions concrètes.</h1>
            <p>
                Choisissez un cursus complet ou une leçon précise, puis progressez à votre rythme.
            </p>
        </section>
        <div class="theme-grid">
            {% for theme in themes %}
                <section class="theme-card">
                    <h2>{{ theme.name }}</h2>
                    <ul>
                        {% for curriculum in theme.curricula %}
                            <li>
                                <a href="{{ path('app_curriculum', { id: curriculum.id }) }}">
                                    {{ curriculum.title }}
                                </a>
                                <span>
                                    {{ (curriculum.priceCents / 100)|number_format(2, ',', ' ') }} €
                                </span>
                            </li>
                        {% endfor %}
                    </ul>
                </section>
            {% endfor %}
        </div>
    </main>
{% endblock %}
