{# Champs communs aux formulaires de création et de modification d’une leçon. #}
<select name="curriculum_id" required>
    {% for curriculum in curricula %}
        <option
            value="{{ curriculum.id }}"
            {{ lesson and lesson.curriculum.id == curriculum.id ? 'selected' }}
        >
            {{ curriculum.title }}
        </option>
    {% endfor %}
</select>
<input name="title" value="{{ lesson ? lesson.title }}" placeholder="Titre" required />
<input name="position" type="number" min="1" value="{{ lesson ? lesson.position : 1 }}" required />
<input
    name="price"
    type="number"
    min="0"
    step="0.01"
    value="{{ lesson ? lesson.priceCents / 100 : 0 }}"
    required
/>
<input
    name="video_url"
    type="url"
    value="{{ lesson ? lesson.videoUrl }}"
    placeholder="URL vidéo (facultative)"
/>
<textarea name="content" required placeholder="Contenu">{{ lesson ? lesson.content }}</textarea>
