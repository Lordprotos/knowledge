{% extends 'base.html.twig' %}
{% block title %}Backoffice | Knowledge Learning{% endblock %}
{% block body %}<main><h1>Backoffice</h1><h2>Comptes utilisateurs</h2><table><tr><th>E-mail</th><th>Rôles</th><th>Activé</th></tr>{% for user in users %}<tr><td>{{ user.email }}</td><td>{{ user.roles|join(', ') }}</td><td>{{ user.verified ? 'Oui' : 'Non' }}</td></tr>{% endfor %}</table><h2>Contenus</h2>{% for theme in themes %}<p>{{ theme.name }} : {% for curriculum in theme.curricula %}{{ curriculum.title }}{% if not loop.last %}, {% endif %}{% endfor %}</p>{% endfor %}<h2>Achats simulés</h2><table><tr><th>Client</th><th>Produit</th><th>Montant</th></tr>{% for purchase in purchases %}<tr><td>{{ purchase.user.email }}</td><td>{% if purchase.curriculum %}{{ purchase.curriculum.title }}{% else %}{{ purchase.lesson.title }}{% endif %}</td><td>{{ (purchase.amountCents / 100)|number_format(2, ',', ' ') }} €</td></tr>{% endfor %}</table></main>{% endblock %}
