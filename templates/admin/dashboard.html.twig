{% extends 'base.html.twig' %}
{% block title %}
    Administration | Knowledge Learning
{% endblock %}
{% block body %}
    <main>
        <h1>Administration</h1>
        <section>
            <h2>Thèmes</h2>
            <form method="post" action="{{ path('app_admin_theme_new') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('theme_new') }}" />
                <input name="name" placeholder="Nouveau thème" required />
                <button>Créer</button>
            </form>
            {% for theme in themes %}
                <article>
                    <form
                        method="post"
                        action="{{ path('app_admin_theme_edit', { id: theme.id }) }}"
                    >
                        <input
                            type="hidden"
                            name="_token"
                            value="{{ csrf_token('theme_edit_' ~ theme.id) }}"
                        />
                        <input name="name" value="{{ theme.name }}" required />
                        <button>Enregistrer</button>
                    </form>
                    <form
                        method="post"
                        action="{{ path('app_admin_theme_delete', { id: theme.id }) }}"
                    >
                        <input
                            type="hidden"
                            name="_token"
                            value="{{ csrf_token('theme_delete_' ~ theme.id) }}"
                        />
                        <button onclick="return confirm('Supprimer ce thème et ses parcours ?')">
                            Supprimer
                        </button>
                    </form>
                </article>
            {% endfor %}
        </section>
        <section>
            <h2>Parcours</h2>
            <form method="post" action="{{ path('app_admin_curriculum_new') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('curriculum_new') }}" />
                <select name="theme_id" required>
                    {% for theme in themes %}
                        <option value="{{ theme.id }}">
                            {{ theme.name }}
                        </option>
                    {% endfor %}
                </select>
                <input name="title" placeholder="Titre" required />
                <input
                    name="price"
                    type="number"
                    min="0"
                    step="0.01"
                    placeholder="Prix €"
                    required
                />
                <button>Créer</button>
            </form>
            {% for curriculum in curricula %}
                <article>
                    <form
                        method="post"
                        action="{{ path('app_admin_curriculum_edit', { id: curriculum.id }) }}"
                    >
                        <input
                            type="hidden"
                            name="_token"
                            value="{{ csrf_token('curriculum_edit_' ~ curriculum.id) }}"
                        />
                        <select name="theme_id">
                            {% for theme in themes %}
                                <option
                                    value="{{ theme.id }}"
                                    {{ theme.id == curriculum.theme.id ? 'selected' }}
                                >
                                    {{ theme.name }}
                                </option>
                            {% endfor %}
                        </select>
                        <input name="title" value="{{ curriculum.title }}" required />
                        <input
                            name="price"
                            type="number"
                            min="0"
                            step="0.01"
                            value="{{ curriculum.priceCents / 100 }}"
                            required
                        />
                        <button>Enregistrer</button>
                    </form>
                    <form
                        method="post"
                        action="{{ path('app_admin_curriculum_delete', { id: curriculum.id }) }}"
                    >
                        <input
                            type="hidden"
                            name="_token"
                            value="{{ csrf_token('curriculum_delete_' ~ curriculum.id) }}"
                        />
                        <button onclick="return confirm('Supprimer ce parcours et ses leçons ?')">
                            Supprimer
                        </button>
                    </form>
                </article>
            {% endfor %}
        </section>
        <section>
            <h2>Leçons</h2>
            <form method="post" action="{{ path('app_admin_lesson_new') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('lesson_new') }}" />
                {% include 'admin/_lesson_fields.html.twig' with { lesson: null } %}
                <button>Créer</button>
            </form>
            {% for lesson in lessons %}
                <article>
                    <form
                        method="post"
                        action="{{ path('app_admin_lesson_edit', { id: lesson.id }) }}"
                    >
                        <input
                            type="hidden"
                            name="_token"
                            value="{{ csrf_token('lesson_edit_' ~ lesson.id) }}"
                        />
                        {% include 'admin/_lesson_fields.html.twig' with { lesson: lesson } %}
                        <button>Enregistrer</button>
                    </form>
                    <form
                        method="post"
                        action="{{ path('app_admin_lesson_delete', { id: lesson.id }) }}"
                    >
                        <input
                            type="hidden"
                            name="_token"
                            value="{{ csrf_token('lesson_delete_' ~ lesson.id) }}"
                        />
                        <button onclick="return confirm('Supprimer cette leçon ?')">
                            Supprimer
                        </button>
                    </form>
                </article>
            {% endfor %}
        </section>
        <section>
            <h2>Comptes utilisateurs</h2>
            <table>
                <tr>
                    <th>E-mail</th>
                    <th>Rôles</th>
                    <th>Activé</th>
                </tr>
                {% for user in users %}
                    <tr>
                        <td>{{ user.email }}</td>
                        <td>{{ user.roles|join(', ') }}</td>
                        <td>{{ user.verified ? 'Oui' : 'Non' }}</td>
                    </tr>
                {% endfor %}
            </table>
        </section>
        <section>
            <h2>Achats simulés</h2>
            <table>
                <tr>
                    <th>Client</th>
                    <th>Produit</th>
                    <th>Montant</th>
                </tr>
                {% for purchase in purchases %}
                    <tr>
                        <td>{{ purchase.user.email }}</td>
                        <td>
                            {{ purchase.curriculum
                                ? purchase.curriculum.title
                                : purchase.lesson.title }}
                        </td>
                        <td>{{ (purchase.amountCents / 100)|number_format(2, ',', ' ') }} €</td>
                    </tr>
                {% endfor %}
            </table>
        </section>
    </main>
{% endblock %}
